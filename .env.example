# Porta HTTP do servidor em produção / servidor local (no AI Studio, o padrão é 3000)
PORT=3005

# Ambiente de execução (development | production)
NODE_ENV=production

# Caminho do arquivo de banco de dados SQLite (opcional - padrão: ./almoxarifado.db)
SQLITE_DB_PATH=./almoxarifado.db

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

