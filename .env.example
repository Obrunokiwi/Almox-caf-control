# Porta HTTP do servidor em produção / servidor local (no AI Studio, o padrão é 3000)
PORT=3005

# Ambiente de execução (development | production)
NODE_ENV=production

# Diretório onde os bancos SQLite (.db) são armazenados (opcional - padrão: raiz do projeto)
# Em produção, pode ser apontado para: /var/lib/almoxcontrol/data
DB_DIR=./

# Caminho do arquivo de banco de dados SQLite da área padrão (opcional - padrão: ./almoxarifado.db)
SQLITE_DB_PATH=./almoxarifado.db

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

